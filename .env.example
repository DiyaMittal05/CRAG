OPENAI_API_KEY=
CRAG_CHAT_MODEL=gpt-4o-mini
CRAG_EMBEDDING_MODEL=text-embedding-3-small
CRAG_CHROMA_DIR=./data/chroma
CRAG_DOCS_DIR=./data/docs
CRAG_RETRIEVER_K=4
CRAG_RELEVANCE_THRESHOLD=0.6
